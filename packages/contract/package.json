{
  "name": "@calendar/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsp compile .",
    "typecheck": "tsp compile . --warn-as-error",
    "watch": "tsp compile . --watch",
    "clean": "node -e \"require('node:fs').rmSync('tsp-output', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@typespec/compiler": "1.18.0",
    "@typespec/http": "1.18.0",
    "@typespec/openapi": "1.18.0",
    "@typespec/openapi3": "1.18.0"
  }
}
